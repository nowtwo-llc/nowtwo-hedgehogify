{
    "compileOnSave": true,
    "compilerOptions": {
        "module": "commonjs",
        "target": "es5",
        "lib": ["es2018", "dom"],
        "outDir": "dist",
        "noImplicitAny": true,
        "removeComments": true,
        "declaration": true,
        "sourceMap": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["./src", "./test", "./demo", "**.js"],
    "exclude": ["node_modules/**"],
    "tsconfigRootDir": "src"
}
