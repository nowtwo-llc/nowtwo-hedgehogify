{
    "compileOnSave": true,
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["es2020", "dom", "dom.iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "removeComments": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2020"
    },
    // No outDir/rootDir here: webpack owns the bundle output and
    // tsconfig.types.json owns declaration emit. Keeping this config
    // emit-free lets it cover src, tests and example for the editor,
    // `npm run typecheck` and type-aware ESLint rules.
    "exclude": ["./node_modules"],
    "include": ["./src", "./tests", "./example", "./vitest.config.mts"],
    "typeRoots": ["./node_modules/@types", "./src"]
}
