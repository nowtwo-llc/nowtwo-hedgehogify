        "eslint-loader": "^3.0.2",
        "eslint-plugin-import": "^2.18.2",
        "eslint-plugin-prettier": "^3.1.1",
        "husky": "^3.0.9",
        "karma": "^6.3.14",
        "karma-chai": "^0.1.0",
        "karma-chrome-launcher": "^3.1.0",
        "karma-mocha": "^1.3.0",
        "lint-staged": "^9.4.2",
        "mini-css-extract-plugin": "^0.8.0",
        "mocha": "^6.2.2",
        "nwb": "0.23.x",
        "optimize-css-assets-webpack-plugin": "^5.0.3",
