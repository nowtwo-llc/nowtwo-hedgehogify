{
    "name": "@nowtwo-llc/hedgehogify",
    "version": "3.1.0",
    "description": "The best way to get hedgehogs to explode all over a website.",
    "keywords": [
        "hedgehog",
        "animation",
        "effects",
        "browser",
        "dom",
        "typescript",
        "fun",
        "easter-egg",
        "konami"
    ],
    "author": "NowTwo LLC <support@nowtwo.io> (https://www.nowtwo.io/)",
    "license": "MIT",
    "homepage": "https://github.com/nowtwo-llc/nowtwo-hedgehogify#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowtwo-llc/nowtwo-hedgehogify.git"
    },
    "bugs": {
        "url": "https://github.com/nowtwo-llc/nowtwo-hedgehogify/issues"
    },
    "main": "./dist/hedgehogify.cjs",
    "module": "./dist/hedgehogify.mjs",
    "types": "./dist/types/HedgeHogify.d.ts",
    "unpkg": "./dist/hedgehogify.min.js",
    "jsdelivr": "./dist/hedgehogify.min.js",
    "exports": {
        ".": {
            "types": "./dist/types/HedgeHogify.d.ts",
            "import": "./dist/hedgehogify.mjs",
            "require": "./dist/hedgehogify.cjs",
            "default": "./dist/hedgehogify.mjs"
        },
        "./assets/*": "./assets/*",
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist/",
        "assets/"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "assets": "node scripts/generate-assets.mjs",
        "build": "npm run build:prod",
        "build:dev": "npm run assets && cross-env NODE_ENV=development webpack --progress",
        "build:prod": "npm run clean:dist && npm run assets && cross-env NODE_ENV=production BUILD_DIR=./dist/ webpack --progress && npm run build:types",
        "build:types": "tsc -p tsconfig.types.json",
        "clean": "rm -rf build dist",
        "clean:dist": "rm -rf dist",
        "demo": "npm run build:prod && node scripts/serve-demo.mjs",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,mjs,json}\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,mjs,json}\"",
        "lint": "npm run oxlint && npm run format",
        "lint:check": "oxlint --max-warnings=0 && npm run format:check",
        "lint:fix": "npm run lint",
        "oxlint": "oxlint --fix",
        "prepublishOnly": "npm run build:prod",
        "test": "npm run assets && vitest run",
        "test:coverage": "npm run assets && vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "npm run assets && tsc -p tsconfig.json --noEmit",
        "update": "npm-check-updates -u --reject jsdom",
        "update:check": "npm-check-updates",
        "watch": "npm run assets && cross-env NODE_ENV=development webpack --progress --watch"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.10",
        "cross-env": "^10.1.0",
        "esbuild-loader": "^4.5.0",
        "jsdom": "^30.0.1",
        "npm-check-updates": "^23.0.0",
        "oxlint": "^1.77.0",
        "prettier": "^3.9.6",
        "terser-webpack-plugin": "^5.6.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2"
    }
}
