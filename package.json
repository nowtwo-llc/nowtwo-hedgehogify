{
    "author": "Classify Learning",
    "name": "@classifylearning/hedgehogify",
    "description": "The best way to get hedgehogs to explode all over a website.",
    "repository": "git@github.com:classifylearning/hedgehogify.git",
    "main": "src/HedgeHogify.ts",
    "license": "MIT",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "scripts": {
        "build:dev": "cross-env NODE_ENV=development webpack --progress",
        "build:prod": "cross-env NODE_ENV=production BUILD_DIR=./dist/ webpack --progress",
        "clean": "rm -rf build dist",
        "eslint:format": "prettier-eslint --eslint-config-path '.eslintrc' --write $PWD/'src/**/*.{js,ts,jsx,tsx,vue}' $PWD/'*.{js,ts}'",
        "eslint:report": "clear && echo 'Generating report in eslint-report.html...' && echo 'Generated file will be visible after command finishes' && eslint --fix --cache --color -o eslint-report.html -f html $PWD/'src/**/*.{js,ts,jsx,tsx,vue}'",
        "eslint": "eslint --fix --cache --color",
        "test:unit": "karma start karma.config.js",
        "test": "npm run build:dev && npm run test:unit",
        "update": "npm-check-updates -u",
        "watch": "cross-env NODE_ENV=development webpack --progress --watch"
    },
    "version": "1.2.0",
    "files": [
        "build/",
        "dist/"
    ],
    "dependencies": {
        "konami": "^1.7.0"
    },
    "devDependencies": {
        "@babel/core": "^7.28.0",
        "@babel/eslint-parser": "^7.28.0",
        "acorn": "^8.15.0",
        "chai": "^4.5.0",
        "clean-webpack-plugin": "^4.0.0",
        "cross-env": "^10.0.0",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^7.0.2",
        "dotenv": "^17.2.1",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "filemanager-webpack-plugin": "^9.0.1",
        "husky": "^9.1.7",
        "karma": "^6.4.4",
        "karma-chai": "^0.1.0",
        "karma-chrome-launcher": "^3.2.0",
        "karma-mocha": "^2.0.1",
        "lint-staged": "^16.1.2",
        "mini-css-extract-plugin": "^2.9.2",
        "mocha": "^11.7.1",
        "npm-check-updates": "^18.0.2",
        "postcss-import": "^16.1.1",
        "postcss-loader": "^8.1.1",
        "postcss-preset-env": "^10.2.4",
        "prettier": "^3.6.2",
        "prettier-eslint": "^16.4.2",
        "prettier-eslint-cli": "^8.0.1",
        "sass": "^1.89.2",
        "sass-loader": "^16.0.5",
        "stylelint": "^16.22.0",
        "stylelint-prettier": "^5.0.3",
        "terser-webpack-plugin": "^5.3.14",
        "ts-loader": "^9.5.2",
        "typedoc": "^0.28.7",
        "typescript": "^5.8.3",
        "webpack": "^5.100.2",
        "webpack-cli": "^6.0.1"
    }
}
