{
    "author": "Classify Learning",
    "description": "The best way to get hedgehogs to explode all over a website.",
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "files": [
        "dist/"
    ],
    "dependencies": {
        "konami": "^1.6.2"
    },
    "devDependencies": {
        "@babel/core": "^7.5.5",
