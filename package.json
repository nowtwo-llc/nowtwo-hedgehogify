{
    "author": "Classify Learning",
    "name": "@classifylearning/hedgehogify",
    "description": "The best way to get hedgehogs to explode all over a website.",
    "repository": "git@github.com:classifylearning/hedgehogify.git",
    "main": "src/HedgeHogify.ts",
    "license": "MIT",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "scripts": {
        "build:dev": "cross-env NODE_ENV=development webpack --progress",
        "build:prod": "cross-env NODE_ENV=production BUILD_DIR=./dist/ webpack --progress",
        "clean": "nwb clean-module",
        "eslint:format": "prettier-eslint --eslint-config-path '.eslintrc' --write $PWD/'src/**/*.{js,ts,jsx,tsx,vue}' $PWD/'*.{js,ts}'",
        "eslint:report": "clear && echo 'Generating report in eslint-report.html...' && echo 'Generated file will be visible after command finishes' && eslint --fix --cache --color -o eslint-report.html -f html $PWD/'src/**/*.{js,ts,jsx,tsx,vue}'",
        "eslint": "eslint --fix --cache --color",
        "test:unit": "nwb test",
        "test": "yarn run clean && yarn run build && yarn run test:unit",
        "update": "npm-check-updates -u",
        "watch": "cross-env NODE_ENV=development webpack --progress --watch"
    },
    "version": "1.0.2",
    "files": [
        "build/",
        "dist/"
    ],
    "dependencies": {
        "konami": "^1.6.3"
    },
    "devDependencies": {
        "acorn": "^8.8.2",
        "babel-eslint": "^10.1.0",
        "chai": "^4.3.7",
        "clean-webpack-plugin": "^4.0.0",
