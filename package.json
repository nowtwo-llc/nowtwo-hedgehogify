{
    "author": "nowtwo-llc",
    "description": "The best way to get hedgehogs to explode all over a website.",
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "files": [
        "dist/"
    ],
    "dependencies": {
        "konami": "^1.6.2"
    },
    "devDependencies": {
        "@babel/core": "^7.7.0",
        "@types/node": "^12.12.5",
        "@typescript-eslint/eslint-plugin": "2.7.0",
        "@typescript-eslint/parser": "2.7.0",
        "chai": "^4.2.0",
        "commitizen": "^4.0.3",
        "css-loader": "^3.2.0",
        "cz-conventional-changelog": "^3.0.2",
        "eslint": "^6.6.0",
        "eslint-config-airbnb-base": "^14.0.0",
        "eslint-config-prettier": "^6.5.0",
        "eslint-loader": "^3.0.2",
        "eslint-plugin-import": "^2.18.2",
        "eslint-plugin-prettier": "^3.1.1",
        "husky": "^3.0.9",
        "karma": "^4.4.1",
        "karma-chai": "^0.1.0",
        "karma-chrome-launcher": "^3.1.0",
        "karma-mocha": "^1.3.0",
        "lint-staged": "^9.4.2",
        "mini-css-extract-plugin": "^0.8.0",
        "mocha": "^6.2.2",
        "nwb": "0.23.x",
        "prettier": "^1.18.2",
        "prettier-eslint": "^9.0.0",
        "prettier-eslint-cli": "^5.0.0",
        "stylelint": "^11.1.1",
        "stylelint-config-prettier": "^6.0.0",
        "stylelint-prettier": "^1.1.1",
        "ts-loader": "^6.2.1",
        "typedoc": "^0.15.1",
        "typescript": "^3.7.2",
        "webpack": "^4.41.2",
        "webpack-cli": "^3.3.10",
        "webpack-dev-server": "^3.9.0"
    },
    "engines": {
        "node": "^10.13.0",
        "npm": "^5.6.0",
        "yarn": "^1.9.4"
    },
    "licenses": [
        {
            "type": "ISC ©2019 nowtwo-llc All Rights Reserved",
            "url": "https://nowtwo-llc.com/privacy.html"
        }
    ],
    "main": "src/HedgeHogify.ts",
    "name": "hedgehogify",
    "version": "1.0.0",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/nowtwo-llc/hedgehogify"
    },
    "scripts": {
        "build": "nwb build-web-module --copy-files && ./cleanout.sh",
        "build:dev": "NWB_MODE=development nwb build-web-module --copy-files && ./cleanout.sh",
        "commit": "git-cz",
        "eslint:format": "prettier-eslint --eslint-config-path '.eslintrc' --write",
        "eslint:report": "clear && echo 'Generating report in eslint-report.html...' && echo 'Generated file will be visible after command finishes' && eslint --fix --cache --color -o eslint-report.html --ignore-path '.tests/unit/HedgeHogify.spec.js' -f html './src/**/*.ts' './tests/**/*.js'; clear; open eslint-report.html || xdg-open eslint-report.html",
        "eslint": "eslint --fix --cache --color",
        "postbuild": "echo \"\\x1b[92mBuild Complete!\\x1b[0m\"",
        "lint": "lint-staged",
        "serve": "http-server example -c-1 -o",
        "stylelint": "stylelint --fix",
        "test:e2e": "echo 'No e2e tests configured'",
        "test:unit": "karma start --single-run --browsers ChromeHeadless karma.conf.js",
        "test": "yarn build && yarn test:unit && yarn test:e2e"
    }
}
