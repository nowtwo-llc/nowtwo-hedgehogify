        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-vue": "^9.9.0",
        "filemanager-webpack-plugin": "^8.0.0",
        "husky": "^8.0.3",
        "karma": "^6.4.1",
        "karma-chai": "^0.1.0",
        "karma-chrome-launcher": "^3.1.1",
        "karma-mocha": "^2.0.1",
        "lint-staged": "^13.1.2",
        "mini-css-extract-plugin": "^2.7.2",
        "mocha": "^10.2.0",
        "npm-check-updates": "^16.7.9",
