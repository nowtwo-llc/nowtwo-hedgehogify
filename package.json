            "url": "https://classifylearning.com/privacy.html"
        }
    ],
    "main": "src/ts/hedgeHogify.ts",
    "name": "hedgehogify",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/fanxchange/venue-map-component"
    },
    "scripts": {
        "build": "webpack --mode=development && mkdir -p example/dist && cp -r dist/ example/dist",
        "commit": "git-cz",
        "eslint:format": "prettier-eslint --eslint-config-path '.eslintrc' --write",
        "eslint:report": "clear && echo 'Generating report in eslint-report.html...' && echo 'Generated file will be visible after command finishes' && eslint --fix --cache --color -o eslint-report.html --ignore-path '.tests/unit/VenueMapComponent.spec.js' -f html './src/**/*.ts' './tests/**/*.js'; clear; open eslint-report.html || xdg-open eslint-report.html",
        "eslint": "eslint --fix --cache --color",
        "postbuild": "echo \"\\x1b[92mBuild Complete!\\x1b[0m\"",
        "serve": "http-server example -c-1 -o",
        "stylelint": "stylelint --fix",
        "test:e2e": "echo 'No e2e tests configured'",
        "test:unit": "karma start --single-run --browsers ChromeHeadless karma.conf.js",
        "test": "yarn build && yarn test:unit && yarn test:e2e"
    }
}
