        "sass": "^1.77.8",
        "sass-loader": "^16.0.0",
        "stylelint": "^16.8.1",
        "stylelint-prettier": "^5.0.2",
        "terser-webpack-plugin": "^5.3.10",
        "ts-loader": "^9.5.1",
        "typedoc": "^0.26.5",
        "typescript": "^5.5.4",
        "webpack": "^5.93.0",
        "webpack-cli": "^5.1.4"
    }
